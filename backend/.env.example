# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env. It is ignored by .gitignore.

APP_NAME=AI Growth Agent API
ENVIRONMENT=development

# Local SQLite database. The schema is created automatically on first use.
DATABASE_URL=sqlite:///./data/ai_growth_agent.db

# Comma-separated origins allowed to call the backend.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay TEST MODE credentials.
# You must provide your own credentials from the Razorpay Dashboard in Test Mode.
# The backend rejects any key id that does not start with "rzp_test_",
# so live/production credentials cannot be used with this project.
# No real money is involved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
